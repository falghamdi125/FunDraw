{
  "name": "fundraw",
  "productName": "FunDraw",
  "version": "1.0.0",
  "description": "FunDraw — infinite-canvas pen notebook with pressure, pasted images and an always-on-top learn mode",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "icon": "node launch.js scripts/make-icon.js",
    "dist": "electron-builder --win msi"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "author": "FunDraw",
  "build": {
    "appId": "com.fundraw.app",
    "productName": "FunDraw",
    "copyright": "FunDraw",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "msi"
      ],
      "icon": "build/icon.ico"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FunDraw",
      "runAfterFinish": true
    }
  }
}
